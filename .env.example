# OpenRouter API key. Used by LiteLLM proxy -> NevNew's chat model
# (qwen/qwen3.8-max-0902, see config.yaml; PAID — capped by
# litellm_settings.max_budget in config.yaml), and by
# scripts/offload_to_minimax.sh -> minimax/minimax-m3:free.
OPENROUTER_API_KEY=your-openrouter-api-key-here
LITELLM_MASTER_KEY=sk-newnew-change-me
MCPO_API_KEY=your-mcpo-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_OWNER_ID=your-numeric-telegram-user-id-here
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
