# Copy this file to .env and fill in real values.
# Never commit the real .env file — it holds live secrets.

# OpenRouter API key. Used for two things, both via OpenRouter/Cline access:
#   1. LiteLLM proxy -> NevNew's chat models (currently z-ai/glm-5.2:free +
#      2 free fallbacks, see config.yaml), which answer users in Open-WebUI.
#   2. scripts/offload_to_minimax.sh -> cline/minimax-m3
#      (minimax/minimax-m3:free), the engineering offload worker.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenCode Zen API key — the 4th NevNew chat deployment in config.yaml
# (nemotron-3-ultra-free, plain OpenAI-compatible endpoint at
# https://opencode.ai/zen/v1). Added 2026-09-06: a genuinely separate quota
# pool from OPENROUTER_API_KEY above, so NevNew keeps answering even when
# OpenRouter's account-wide 50 req/day free-tier cap takes all 3 OpenRouter
# deployments down at once (see BACKLOG.md / issue #7). Get one via
# `opencode auth login` -> opencode/Zen, then read it from
# ~/.local/share/opencode/auth.json's "opencode" entry's "key" field.
OPENCODE_ZEN_API_KEY=your-opencode-zen-api-key-here

# Master key LiteLLM uses to authenticate incoming requests (from Open-WebUI
# and any other client). Pick a long random string, e.g.:
#   openssl rand -hex 32
LITELLM_MASTER_KEY=sk-newnew-change-me

# API key mcpo (MCP-to-OpenAPI proxy) requires callers to present, and that
# Open-WebUI's External Tool Server registration authenticates with in turn.
# Bridges n8n's MCP Server Trigger workflows into Open-WebUI's OpenAPI-only
# tool server support (see BACKLOG.md / GitHub issue #1). Pick a long random
# string, e.g.: openssl rand -hex 24
MCPO_API_KEY=your-mcpo-api-key-here

# Telegram bot (issue #11 — MVP mobile/push channel). Token from @BotFather
# (/mybots -> select bot -> API Token). OWNER_ID is the numeric Telegram user
# ID (from @userinfobot) allowed to use the bot — the whitelist, not optional,
# see #11's cost/abuse-risk rationale.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_OWNER_ID=your-numeric-telegram-user-id-here
