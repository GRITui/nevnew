# 9arm API key. Used by:
#   1. LiteLLM proxy -> NevNew's default chat engine (Open-WebUI):
#      qwen3.8-27b-fp8 via https://gateway.9arm.co/v1.
#   2. telegram-bot's Cline primary backend (same provider/model as the
#      Cline session) — passed to the cline CLI via -k at runtime.
NINEARM_API_KEY=your-9arm-api-key-here

# OpenRouter API key. Still used by NevNew-Pro, Telegram image OCR, and the
# explicit metered engineering offload fallback.
OPENROUTER_API_KEY=your-openrouter-api-key-here
LITELLM_MASTER_KEY=sk-newnew-change-me
MCPO_API_KEY=your-mcpo-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_OWNER_ID=your-numeric-telegram-user-id-here
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# telegram-bot's chat backends: the `cline` CLI (9arm gateway /
# qwen3.8-27b-fp8, via NINEARM_API_KEY above) is primary; the `claude` CLI
# (Sonnet) is fallback. This token is for the Sonnet fallback — generate
# with `claude setup-token` (browser OAuth, no API key involved; container
# has no macOS Keychain).
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token-here
