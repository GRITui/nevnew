# OpenRouter API key. Used by LiteLLM proxy -> NevNew's free chat model
# chain (minimax/minimax-m3:free primary; nemotron-3-ultra + gemma-4-31b
# free fallbacks — see config.yaml). NevNew-Pro (qwen3.8-max) is a paid
# model and is capped by litellm_settings.max_budget in config.yaml.
# scripts/offload_to_minimax.sh also uses this key for offload work.
OPENROUTER_API_KEY=your-openrouter-api-key-here
LITELLM_MASTER_KEY=sk-newnew-change-me
MCPO_API_KEY=your-mcpo-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_OWNER_ID=your-numeric-telegram-user-id-here
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# telegram-bot's chat backends: opencode (OpenCode Go quota) is primary,
# `claude` CLI (Sonnet) is fallback. OpenCode Go auth is a mounted
# auth.json (see docker-compose.yml), not an env var. This token is for
# the Sonnet fallback — generate with `claude setup-token` (browser OAuth,
# no API key involved; container has no macOS Keychain).
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token-here
