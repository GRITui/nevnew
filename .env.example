# 9arm API key. Used by:
#   1. LiteLLM proxy -> NevNew's default chat engine (Open-WebUI):
#      qwen3.8-27b-fp8 via https://gateway.9arm.co/v1.
#   2. telegram-bot's Cline primary backend (same provider/model as the
#      Cline session) — passed to the cline CLI via -k at runtime.
NINEARM_API_KEY=your-9arm-api-key-here

# OpenRouter API key. Still used by NevNew-Pro, Telegram image OCR, and the
# explicit metered engineering offload fallback.
OPENROUTER_API_KEY=your-openrouter-api-key-here
LITELLM_MASTER_KEY=sk-newnew-change-me
MCPO_API_KEY=your-mcpo-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_OWNER_ID=your-numeric-telegram-user-id-here
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# telegram-bot's chat backends: ai-core POST /chat is primary when
# USE_AI_CORE=true (One Brain, #70); the `cline` CLI (9arm gateway /
# qwen3.8-27b-fp8, via NINEARM_API_KEY above) then the `claude` CLI (same
# gateway/model) are fallback tiers. Rollback: USE_AI_CORE=false.
USE_AI_CORE=true
AICORE_API_KEY=your-aicore-api-key-here
MEMORY_API_KEY=your-memory-api-key-here

# Web search (ai-core web_search tool + POST /web_search). Provider
# auto-resolves: tavily if TAVILY_API_KEY set, else brave if BRAVE_API_KEY
# set, else keyless duckduckgo.
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=your-tavily-api-key-here
BRAVE_API_KEY=your-brave-api-key-here

# Legacy: CLAUDE_CODE_OAUTH_TOKEN was the old Sonnet-fallback auth before
# e42a786 (bot now points the claude CLI at the 9arm gateway instead).
# Kept here so old .env files still parse; safe to delete.
CLAUDE_CODE_OAUTH_TOKEN=your-claude-code-oauth-token-here
